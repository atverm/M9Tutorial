MODULE C6Nan ;

(* Chapter 6.  A NaN in a sample is a MISSING VALUE: the mean of
   [1, NaN, 3] is 2, over the two values that are there.  The
   library says how many that was.  A skip nobody can see changes n
   behind your back; a skip with its count beside it is a statement
   about your data.  A sample of nothing but gaps is not answered
   at all: it is refused, by that same count.                      *)

IMPORT Io ;
IMPORT Stats ;

VAR
  xs, gaps : ARRAY 3 OF F64 ;
  m : F64 ;
  i : I64 ;

BEGIN
  xs [0] := 1.0 ;
  xs [1] := NaN ;                   (* a gap, as data has *)
  xs [2] := 3.0 ;
  m := Stats.Mean (xs) ;
  Io.WriteLine ($'mean = ${m:.3} over ${Stats.Count (xs)}'
                + $' of ${LEN (xs)} values') ;
  FOR i := 0 TO 2 DO gaps [i] := NaN END ;
  m := Stats.Mean (gaps) ;
  Io.WriteLine ($'mean = ${m:.3}')
EXCEPT
| Stats.TooFew (got, need) :
    Io.WriteLine ($'nothing but gaps: ${got} values, '
                  + $'and a mean needs ${need}')
| ValueRange :
    Io.WriteLine ('formatting failed')
END C6Nan.
