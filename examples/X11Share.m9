MODULE X11Share ;

(* EXPECT-ERROR: cannot write through a value parameter: j is a shared borrow *)

(* M9 refuses the mistake threading invites, before it can race.

   A worker is handed a pointer to the job it shares with the others.
   As a VALUE parameter, that pointer is a SHARED BORROW (report
   par 4.1).  Everyone may read it; nobody may write through it.
   This worker tries to keep its own tally in the shared record.
   Two workers doing that make a data race.  A race that fires one
   time in ten is the kind of bug that survives a hundred green
   test runs.

   The fix is one word: VAR.  It says out loud that this parameter
   is the mutable handle.  Chapter 11's C11Fetch does exactly that,
   and writes only at its own index.                               *)

IMPORT Io ;

TYPE
  Job = RECORD
    done : I64 ;
  END ;

PROCEDURE Worker (j: PTR Job) =
BEGIN
  j.done := j.done + 1
END Worker ;

VAR
  pool : POOL ;
  p : PTR Job IN pool ;

BEGIN
  p := NEW (pool, Job) ;
  p.done := 0 ;
  Worker (p) ;
  Io.WriteLine ('never gets here')
END X11Share.
